{
  "name": "@xaa/icon-astro",
  "version": "0.0.1",
  "description": "A Xaa icon library package for Astro applications.",
  "license": "ISC",
  "private": false,
    "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nahida-aa/icon.git"
  },
  "keywords": [
    "Xaa",
    "Astro",
    "Feather",
    "Icons",
    "Icon",
    "SVG",
    "Feather Icons",
    "Fontawesome",
    "Font Awesome"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./icons": {
      "import": "./src/index.ts"
    },
    "./icons/*": {
      "import": "./src/icons/*.ts"
    }
  },
  "scripts": {
    "astro-check": "astro check",
    "copy:utils": "mkdir -p ./src/utils && for f in hasA11yProp toKebabCase mergeClasses; do cp -f ../../packages/build-icons/utils/$f.ts ./src/utils/; done",
    "build": "bun run copy:utils && bun run build:icons",
    "build:icons": "build-icons --output=./src --templateSrc=./scripts/exportTemplate.mts --renderUniqueKey --withAliases --aliasesFileExtension=.ts --iconFileExtension=.ts --exportFileName=index.ts --pretty=false",
    "clean": "rm -rf dist && rm -rf stats && rm -rf ./src/icons/*.ts",
    "copy:license": "cp ../../LICENSE ./LICENSE"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.4",
    "jest-serializer-html": "^7.1.0",
    "linkedom": "^0.18.5",
    "prettier": "^3.4.2",
   "typescript": "catalog:",
    "vite": "catalog:",
    "@astrojs/check": "latest",
    "vitest": "^4.1.1",
    "astro": "^6.1.6"
  },
  "peerDependencies": {
    "astro": "^4 || ^5 || ^6"
  }
}
