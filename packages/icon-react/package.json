{
  "name": "@xaa/icon-react",
  "version": "0.0.9",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "vite build",
    "build:icons": "build-icons --output=./src --templateSrc=./scripts/exportTemplate.mts --renderUniqueKey --withAliases --withDynamicImports --separateAliasesFile --separateAliasesFileIgnore=fingerprint --aliasesFileExtension=.ts --iconFileExtension=.ts --exportFileName=index.ts"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@xaa/build-icons": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": "^16.5.1 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nahida-aa/icon.git"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "keywords": [
    "Xaa",
    "React",
    "Feather",
    "Icons",
    "Icon",
    "SVG",
    "Feather Icons"
  ]
}