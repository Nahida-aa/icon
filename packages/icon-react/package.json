{
  "name": "@xaa/icon-react",
  "version": "0.0.13",
  "type": "module",
  "description": "React SVG icon components",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun run build:icons && tsdown",
    "build:icons": "bun ./../build-icons/cli.ts --output=./src --templateSrc=./scripts/exportTemplate.mts --renderUniqueKey --withAliases --withDynamicImports --separateAliasesFile --separateAliasesFileIgnore=fingerprint --aliasesFileExtension=.ts --iconFileExtension=.ts --exportFileName=index.ts"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "react": "catalog:",
    "@xaa/build-icons": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^16.5.1 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nahida-aa/icon.git"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "keywords": [
    "Xaa",
    "React",
    "Feather",
    "Icons",
    "Icon",
    "SVG",
    "Feather Icons"
  ]
}
