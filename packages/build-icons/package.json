{
  "name": "@xaa/build-icons",
  "version": "0.0.7",
  "type": "module",
  "main": "./index.ts",
  "types": "./types.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./types": {
      "import": "./types.ts",
      "require": "./types.ts"
    },
    "./cli": {
      "import": "./cli.ts",
      "require": "./cli.ts"
    },
    "./utils/*": {
      "import": "./utils/*.ts",
      "require": "./utils/*.ts"
    },
    "./helpers/*": {
      "import": "./helpers/*.ts",
      "require": "./helpers/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "start": "bun ./cli.ts"
  },
  "bin": {
    "build-icons": "./cli.ts"
  },
  "dependencies": {
    "prettier": "^3.8.3",
    "svgson": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "private": false
}
