{
  "name": "@xaa/build-icons",
  "type": "module",
  "exports": {
".": {
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./cli": {
      "import": "./cli.ts",
      "require": "./cli.ts"
    },
    "./utils/*": {
      "import": "./utils/*.ts",
      "require": "./utils/*.ts"
    },
    "./helpers/*": {
      "import": "./helpers/*.ts",
      "require": "./helpers/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "start": "bun ./cli.ts"
  },
  "bin": {
    "build-icons": "bun ./cli.ts"
  },
  "dependencies": {
    "prettier": "^3.8.3",
    "svgson": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}